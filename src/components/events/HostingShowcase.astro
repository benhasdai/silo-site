---
// R3 — the events page body: three hosting types, each a real photograph and
// its full package menu. All package info lives INSIDE its section (user
// ruling); WhatsApp CTA per package replaces the old inquiry form as the
// conversion path.
// Owner ruling 2026-10-14: every menu is always open (no click to reveal),
// with a sticky jump bar between the packages. No-JS baseline: plain anchor
// links; events.ts adds Lenis scroll and the active-package highlight.
// R9 i18n — parameterized by locale: package copy from getEventPackages(locale),
// chrome strings (aria-labels, "per guest", WhatsApp CTA text) from the events
// strings module.
import { WHATSAPP_URL } from '../../lib/links';
import { getEventPackages, menuItemIndex, resolveDish } from './events-menu-data';
import { events } from '../../i18n/pages/events';
import { DEFAULT_LOCALE } from '../../i18n/locales';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = events[locale];
const byId = menuItemIndex();
const packages = getEventPackages(locale);
---
<section class="showcase" aria-label={t.showcaseAriaLabel}>
  <nav class="show-nav" aria-label={t.packageNavAriaLabel} data-package-nav>
    <ul class="show-nav-list" role="list">
      {packages.map((pkg) => (
        <li class="show-nav-item">
          <a class="show-nav-link" href={`#${pkg.id}`} data-package-link={pkg.id}>{pkg.title}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="container">
    <div class="show-list">
      {packages.map((pkg, i) => (
        <article class="show-row" id={pkg.id} aria-labelledby={`${pkg.id}-title`} data-event-package>
          <div class="show-summary">
            <span class={`show-media${i % 2 === 1 ? ' show-media-flip' : ''}`}>
              <img src={pkg.photo} alt={pkg.alt} loading="lazy" decoding="async" width="1200" height="900" />
            </span>
            <div class="show-body">
              <span class="badge-warm">{pkg.tag}</span>
              <h2 class="show-title" id={`${pkg.id}-title`}>{pkg.title}</h2>
              <p class="show-desc">{pkg.body}</p>
              <p class="show-price"><span class="notranslate">{pkg.pricePp} ₪</span> {t.perGuest}</p>
            </div>
          </div>

          <div class="fold">
            <div class="fold-inner">
              <p class="fold-intro">{pkg.intro}</p>

              {pkg.sections.map((sec) => (
                <section class="fold-sec">
                  <h3 class="fold-sec-title">
                    {sec.title}
                    {sec.note && <span class="fold-sec-note">{sec.note}</span>}
                  </h3>
                  {sec.text && <p class="fold-text">{sec.text}</p>}
                  {sec.dishes && (
                    <ul class="fold-dishes" role="list">
                      {sec.dishes.map((d) => {
                        const r = resolveDish(d, byId, locale);
                        return (
                          <li>
                            <span class="fold-dish-name">{r.name}</span>
                            {r.desc && <span class="fold-dish-desc">{r.desc}</span>}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </section>
              ))}

              <section class="fold-sec">
                <h3 class="fold-sec-title">{t.drinksHeading}</h3>
                {pkg.drinks.map((line) => <p class="fold-text">{line}</p>)}
              </section>

              <div class="fold-pricing">
                <p><strong class="notranslate">{pkg.pricePp} ₪</strong> {t.perGuest}</p>
                <p><strong class="notranslate">{pkg.priceKids} ₪</strong> {t.kidsUpTo8}</p>
              </div>

              <ul class="fold-fine" role="list">
                {pkg.finePrint.map((line) => <li>{line}</li>)}
              </ul>

              <p class="fold-cta">
                <a
                  class="btn btn-primary"
                  href={WHATSAPP_URL(t.whatsappMessage(pkg.title, pkg.pricePp))}
                  target="_blank"
                  rel="noopener"
                >{t.ctaLabel(pkg.title)}</a>
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase {
    --show-nav-h: 52px; /* jump-bar row height; also feeds the anchor landing */
    padding-block: var(--space-8) var(--space-16);
  }
  @media (min-width: 768px) {
    .showcase {
      --show-nav-h: 3.5rem;
      padding-block: var(--space-12) var(--space-24);
    }
  }

  .show-list {
    display: grid;
    gap: var(--space-12);
  }

  /* ---- sticky jump bar between the packages (same look as the menu tabs) ---- */
  .show-nav {
    position: sticky;
    inset-block-start: var(--nav-bar-height);
    z-index: 30;
    background: var(--color-background);
    border-block-end: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent); /* = --menu-hairline */
    margin-block-end: var(--space-8);
  }
  .show-nav-list {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--space-4);
    max-inline-size: var(--content-max);
    display: flex;
    justify-content: center;
    gap: var(--space-2);
  }
  .show-nav-item {
    flex: 1 1 0;
  }
  .show-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--show-nav-h);
    padding: var(--space-2) var(--space-1);
    text-align: center;
    line-height: 1.15;
    color: var(--color-on-ground-soft); /* R7.1-C: sage fails on espresso */
    font-weight: var(--weight-heading);
    font-size: var(--text-sm);
    border-block-end: 3px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-smooth),
      border-color var(--dur-fast) var(--ease-smooth);
  }
  .show-nav-link:hover {
    color: var(--color-text);
  }
  /* state indicator in cotto, like .menu-tab.is-active (R7.1-C Option A) */
  .show-nav-link.is-active {
    color: var(--color-text);
    border-block-end-color: var(--color-warm-surface);
  }
  .show-nav-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: -2px;
  }
  @media (min-width: 768px) {
    .show-nav {
      margin-block-end: var(--space-12);
    }
    .show-nav-list {
      gap: var(--space-6);
      padding-inline: var(--space-6);
    }
    .show-nav-item {
      flex: 0 0 auto;
    }
    .show-nav-link {
      padding-inline: var(--space-4);
      font-size: var(--text-base);
      white-space: nowrap;
    }
  }

  /* anchors land below the site bar + the jump bar (+ its hairline). Lenis
     honours this too, and events.ts reads it for the active highlight. */
  .show-row {
    scroll-margin-block-start: calc(var(--nav-bar-height) + var(--show-nav-h) + 1px + var(--space-6));
  }

  /* ---- the card ---- */
  .show-summary {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .show-media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
  }
  /* GSAP owns the img transform (scroll drift). */
  .show-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .show-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .show-title {
    margin: 0;
    font-weight: var(--weight-display);
    font-size: var(--text-xl);
    line-height: 1.15;
  }
  .show-desc {
    margin: 0;
    max-inline-size: 46ch;
    color: var(--color-on-ground-soft); /* R7.1-C: sage fails on espresso */
  }
  .show-price {
    margin: 0;
    font-weight: var(--weight-heading);
  }

  @media (min-width: 768px) {
    .show-summary {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-12);
    }
    /* alternate media side — direction flip keeps markup order and RTL text intact */
    .show-media-flip {
      order: 2;
    }
  }

  /* ---- the package menu (always open) ---- */
  .fold-inner {
    padding-block: var(--space-8) var(--space-4);
    max-inline-size: 44rem;
  }

  .fold-intro {
    font-size: var(--text-lg);
    line-height: 1.7;
    max-inline-size: 55ch;
  }

  .fold-sec {
    margin-block-start: var(--space-8);
  }
  .fold-sec-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
  }
  .fold-sec-title::before {
    content: '';
    flex: none;
    inline-size: var(--space-6);
    block-size: 3px;
    border-radius: 999px;
    background: var(--color-warm-surface);
  }
  .fold-sec-note {
    color: var(--color-on-ground-soft); /* R7.1-C: sage fails on espresso */
    font-weight: var(--weight-body);
    font-size: var(--text-sm);
  }

  .fold-text {
    margin-block-start: var(--space-3);
    color: var(--color-on-ground-soft); /* R7.1-C: sage fails on espresso */
    max-inline-size: 60ch;
  }

  .fold-dishes {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .fold-dish-name {
    font-weight: var(--weight-heading);
  }
  .fold-dish-desc {
    display: block;
    color: var(--color-on-ground-soft); /* R7.1-C: sage fails on espresso */
    font-size: var(--text-sm);
    max-inline-size: 52ch;
  }

  .fold-pricing {
    margin-block-start: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    font-size: var(--text-lg);
  }
  .fold-pricing strong {
    font-weight: var(--weight-display);
  }

  .fold-fine {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
    color: var(--color-on-ground-soft); /* R7.1-C: sage fails on espresso */
    font-size: var(--text-sm);
  }

  .fold-cta {
    margin-block-start: var(--space-8);
  }
</style>
